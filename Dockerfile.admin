FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app

WORKDIR /app
COPY pyproject.toml ./
COPY requirements ./requirements
COPY app ./app
RUN pip install -r requirements/admin.txt \
    && useradd --create-home --uid 1000 app \
    && chown -R app:app /app

USER app
CMD ["uvicorn", "app.admin.web:create_app", "--factory", "--host", "0.0.0.0", "--port", "8001"]
