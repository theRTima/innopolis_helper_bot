FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app

WORKDIR /app

ARG INSTALL_OFFICE=1
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libgl1 \
        libglib2.0-0 \
    && if [ "$INSTALL_OFFICE" = "1" ]; then \
        apt-get install -y --no-install-recommends \
            libreoffice-writer \
            libreoffice-calc \
            libreoffice-impress \
            fonts-dejavu-core; \
    fi \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml ./
COPY requirements ./requirements
COPY app ./app
COPY scripts ./scripts

# Install CPU-only PyTorch first. The default Linux wheel pulls CUDA/NVIDIA
# libraries that are unnecessary for document extraction and can exhaust
# Docker disk space.
RUN pip install --index-url https://download.pytorch.org/whl/cpu \
    torch torchvision

RUN pip install -r requirements/ingestion.txt

RUN useradd --create-home --uid 1000 app \
    && chown -R app:app /app

USER app

ENTRYPOINT ["python", "scripts/docker_pipeline.py"]
