# Telegram
TELEGRAM_BOT_TOKEN=

# Local llama.cpp server (OpenAI-compatible)
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=gemma-4-e2b
LLM_API_KEY=local
# Required by some OpenAI-compatible providers
LLM_SESSION_ID=innopolis-helper-bot
LLM_USER_AGENT=innopolis-helper-bot/1.0

# Generation / retrieval
ANSWER_MAX_TOKENS=600
TEMPERATURE=0.1
TOP_K=2
MIN_SCORE=0

# Paths
KNOWLEDGE_DIR=data/knowledge
CHUNKS_DIR=data/processed
DOCUMENTS_DIR=data/processed/documents
DATABASE_PATH=storage/bot.db
# Optional: PostgreSQL overrides DATABASE_PATH
# DATABASE_URL=postgresql+asyncpg://bot:password@localhost:5432/bot
POSTGRES_PASSWORD=

# Signed links to the document viewer (HTTPS URL required outside local testing)
DOCUMENTS_BASE_URL=
DOCUMENT_LINK_SECRET=

SUPPORT_URL=
SUPPORT_ESCALATION_THRESHOLD=5
