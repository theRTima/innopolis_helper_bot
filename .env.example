# Telegram
TELEGRAM_BOT_TOKEN=

# OpenAI-compatible provider used for answers and document ingestion
LLM_BASE_URL=https://your-provider.example.com/v1
LLM_MODEL=your-model-id
LLM_API_KEY=your-api-key
# Required by some providers (e.g. OpenCode Go routing)
LLM_SESSION_ID=innopolis-helper-bot
LLM_USER_AGENT=innopolis-helper-bot/1.0
# Fallback reasoning effort when no provider-specific thinking budget is active
LLM_ANSWER_REASONING_EFFORT=minimal
LLM_EXTRACTION_REASONING_EFFORT=low

# Generation / retrieval
ANSWER_MAX_TOKENS=600
# auto enables bounded thinking for the tested OpenCode/qwen3.8-flash pair
LLM_ENABLE_THINKING=auto
# Optional override; auto uses 512 for that pair
# LLM_THINKING_BUDGET=512
# Combined reasoning + answer limit when a thinking budget is active
ANSWER_MAX_COMPLETION_TOKENS=1400
TEMPERATURE=0.1
TOP_K=2
MIN_SCORE=0

# Paths
KNOWLEDGE_DIR=data/knowledge
DOCUMENTS_DIR=data/processed/documents
DATABASE_PATH=data/bot.sqlite3
# Optional: PostgreSQL overrides DATABASE_PATH
# DATABASE_URL=postgresql+asyncpg://bot:password@localhost:5438/bot

# Signed links to the document viewer (HTTPS URL required outside local testing)
DOCUMENTS_BASE_URL=
DOCUMENT_LINK_SECRET=

# Docker Compose
POSTGRES_PASSWORD=change-me
# Grafana (use independent, strong local passwords)
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_DB_PASSWORD=change-me
# GRAFANA_PORT=3000
# POSTGRES_PORT=5438
# HOST_UID=1000
# HOST_GID=1000
# VIEWER_PORT=8090
# For a host-run OpenAI-compatible server from inside Docker:
# LLM_BASE_URL=http://host.docker.internal:8081/v1
